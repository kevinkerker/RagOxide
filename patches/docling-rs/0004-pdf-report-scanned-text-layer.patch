+        t,
+        shown: clipped([l, b, r, t], &gs.image_clips),
+        place: [ctm.a, ctm.b, ctm.c, ctm.d, ctm.e, ctm.f],
+        covers: opaque.then_some(glyphs),
+    }
+}
