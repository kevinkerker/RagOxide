+                    p["bbox"]["l"].as_f64().unwrap(),
+                    [0, 1].map(|k| p["charspan"][k].as_u64().unwrap() as usize),
+                )
+            })
+            .collect();
+        let total = text.chars().count();
+        // The grid x denormalized against the 600 pt page, to 2 decimals.
+        let l = |x: f64| (x * 600.0 / 512.0 * 100.0).round() / 100.0;
+        assert_eq!(
